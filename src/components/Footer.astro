---
interface Props {
  since: number
  title: string
}

const { since, title } = Astro.props
const currentYear = new Date().getFullYear()
const sinceRange = since === currentYear ? String(since) : `${since} - ${currentYear}`
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-copyright">&copy; {sinceRange}</span>
      <a href="/" class="footer-author">{title}</a>
      <span class="footer-divider">|</span>
      <span class="footer-credit">Powered by <a href="https://astro.build/" target="_blank">Astro</a></span>
      <span class="footer-divider">|</span>
      <a
        href="https://creativecommons.org/licenses/by-sa/4.0/"
        class="footer-license"
        target="_blank"
        rel="license noopener noreferrer"
        title="本站内容采用 CC BY-SA 4.0 国际许可协议授权"
      >
        <img
          src="/images/cc-by-sa-4.0-80x15.svg"
          alt="Creative Commons Attribution-ShareAlike 4.0 International License"
          width="80"
          height="15"
          loading="lazy"
        />
      </a>
    </div>
  </div>
</footer>
